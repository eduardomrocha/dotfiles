{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/minimax-m2.5-free",
  "theme": "catppuccin",
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "keybinds": {
    "session_child_cycle": "alt+right",
    "session_child_cycle_reverse": "alt+left",
  },
  "provider": {
    "anthropic": {
      "models": {
        "claude-sonnet-4-5-20250929": {
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            },
            "temperature": 0.7
          }
        }
      }
    },
    "google": {
      "models": {
        "gemini-3-flash-preview": {
          "options": {
            "temperature": 0.7,
            "topP": 0.95,
            "maxOutputTokens": 8192
          }
        },
        "gemini-3-pro-preview": {
          "options": {
            "temperature": 0.7,
            "topP": 0.95,
            "maxOutputTokens": 8192
          }
        }
      }
    }
  }
}
